{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/interactions",
      "dest": "api/index.js"
    },
    {
      "src": "/api/sync",
      "dest": "api/sync.js"
    },
    {
      "src": "/api/health",
      "dest": "api/health.js"
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 5 * * *"
    }
  ]
}
