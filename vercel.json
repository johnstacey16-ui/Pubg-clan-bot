{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "design/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/interactions",
      "dest": "api/index.js"
    },
    {
      "src": "/api/sync",
      "dest": "api/sync.js"
    },
    {
      "src": "/api/health",
      "dest": "api/health.js"
    },
    {
      "src": "/api/public-stats",
      "dest": "api/public-stats.js"
    },
    {
      "src": "/api/player-history",
      "dest": "api/player-history.js"
    },
    {
      "src": "/api/public-matches",
      "dest": "api/public-matches.js"
    },
    {
      "src": "/api/public-insights",
      "dest": "api/public-insights.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/design/(.*)",
      "dest": "/design/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 5 * * *"
    }
  ]
}
